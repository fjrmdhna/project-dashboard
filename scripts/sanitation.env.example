# Template env collector di VPS. Salin ke /opt/project-dashboard/.sanitation.env, isi sendiri, chmod 600.
# JANGAN commit file berisi nilai asli.
# User DB PMIS sebaiknya READ-ONLY. Host/port hanya terjangkau saat VPN (tun0) aktif.
PMIS_DATABASE_URL=postgresql://READONLY_USER:CHANGE_ME@PMIS_DB_HOST:5432/pmisdb_20261008
# NEXT_PUBLIC_SUPABASE_URL dan SUPABASE_SERVICE_ROLE_KEY dibaca otomatis dari /opt/project-dashboard/.env

